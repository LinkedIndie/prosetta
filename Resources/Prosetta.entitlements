<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone access under the hardened runtime.
	     Without this entitlement a hardened-runtime binary is denied the mic outright,
	     regardless of what the user grants in System Settings. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- App Sandbox is deliberately ABSENT, not set to false.
	     Prosetta never uses Accessibility APIs — no global hotkey, no text injection into other
	     apps — so sandboxing isn't blocked by that constraint the way it is for Parla. It's left
	     off anyway to keep spawning the `claude` CLI subprocess simple, and to allow the
	     AppleScript-based Terminal launch for the sign-in flow. -->
</dict>
</plist>
